# AWS credentials are normally resolved by boto3's standard credential chain.
AWS_REGION=us-east-1

# Snowflake connection settings (only needed for snowflake-* commands).
SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_ROLE=MINILAKE_ROLE
SNOWFLAKE_WAREHOUSE=MINILAKE_WH
SNOWFLAKE_DATABASE=MINILAKE
SNOWFLAKE_SCHEMA=ANALYTICS

